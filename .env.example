# Copy to .env and fill in your real values.
# Production DATABASE_URL (PostgreSQL); leave it out for local SQLite:
# DATABASE_URL=postgresql://user:password@host.example/neondb?sslmode=require
# optional:
# DJANGO_SECRET_KEY=create-a-strong-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# In prod, also add the right Expo Web frontend domains (e.g. https://app.example.com).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# AWS: if not set here, boto3 uses the default chain; for dev use the profile:
# AWS_PROFILE=optional-local-aws-profile
# AWS_REGION=sa-east-1
# AWS_IMAGES_BUCKET=your-images-bucket
# AWS_RESULTS_BUCKET=your-results-bucket
AWS_LAMBDA_ECG_READING=ecg-reading
AWS_LAMBDA_ECG_INTERPRETATION=ecg-interpretation
ECG_TEST_SCENARIOS_ENABLED=False
# PRESIGN_URL_EXPIRES=3600

# Phase execution: inline (dev) or sqs (prod; the `manage.py ecg_worker` worker consumes the queue).
ECG_TASK_MODE=inline
# ECG_TASK_QUEUE_URL=https://sqs.sa-east-1.amazonaws.com/<account>/ecg-tasks
# APP_VERSION=dev

# The real ecg-reading runs up to 900 s (50-190 s in practice); boto3 waits up to AWS_LAMBDA_READ_TIMEOUT and does not re-invoke.
AWS_LAMBDA_READ_TIMEOUT=930
# An attempt processing for longer than this becomes a TASK_TIMEOUT error (retryable).
# STALE_PROCESSING_SECONDS=1200
# Queue messages processed in parallel by the worker (threads).
# ECG_WORKER_CONCURRENCY=4

# --- Production (ECS; plan B4) ---
# Database: DATABASE_URL takes priority; else DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD (sslmode=require).
# DB_HOST=ecg.xxxx.sa-east-1.rds.amazonaws.com
# DB_NAME=ecg
# DB_USER=ecg_admin
# DB_PASSWORD=  (SSM /ecg/prod/DB_PASSWORD)
# CSRF_TRUSTED_ORIGINS=https://<api-id>.execute-api.sa-east-1.amazonaws.com
# SECURE_HSTS_SECONDS=31536000
# LOG_LEVEL=INFO
# ensure_admin: ADMIN_USERNAME / ADMIN_PASSWORD (SSM /ecg/prod/)
