# Copie para .env e preencha com seus valores reais.
# DATABASE_URL de produção (PostgreSQL); deixe de fora para SQLite local:
# DATABASE_URL=postgresql://usuario:senha@host.example/neondb?sslmode=require
# opcional:
# DJANGO_SECRET_KEY=crie-uma-chave-aleatoria-forte-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Em prod, adicione também os domínios corretos do frontend Expo Web (ex.: https://app.example.com).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# AWS — se não setado aqui, boto3 usa a cadeia padrão; para dev use o perfil:
# AWS_PROFILE=perfil-aws-local-opcional
# AWS_REGION=sa-east-1
# AWS_IMAGES_BUCKET=seu-bucket-de-imagens
# AWS_RESULTS_BUCKET=seu-bucket-de-resultados
AWS_LAMBDA_ECG_READING=ecg-reading
AWS_LAMBDA_ECG_INTERPRETATION=ecg-interpretation
ECG_TEST_SCENARIOS_ENABLED=False
# PRESIGN_URL_EXPIRES=3600

# Execução das fases: inline (dev) ou sqs (prod; o worker `manage.py ecg_worker` consome a fila).
ECG_TASK_MODE=inline
# ECG_TASK_QUEUE_URL=https://sqs.sa-east-1.amazonaws.com/<conta>/ecg-tasks
# APP_VERSION=dev

# A ecg-reading real roda até 900 s (50–190 s na prática); o boto3 espera até AWS_LAMBDA_READ_TIMEOUT e não reinvoca.
AWS_LAMBDA_READ_TIMEOUT=930
# Tentativa em *_processando há mais que isso vira erro TASK_TIMEOUT (retryable).
# STALE_PROCESSING_SECONDS=1200
# Mensagens da fila processadas em paralelo pelo worker (threads).
# ECG_WORKER_CONCURRENCY=4

# --- Produção (ECS; plano B4) ---
# Banco: DATABASE_URL tem prioridade; senão DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD (sslmode=require).
# DB_HOST=ecg.xxxx.sa-east-1.rds.amazonaws.com
# DB_NAME=ecg
# DB_USER=ecg_admin
# DB_PASSWORD=  (SSM /ecg/prod/DB_PASSWORD)
# CSRF_TRUSTED_ORIGINS=https://<api-id>.execute-api.sa-east-1.amazonaws.com
# SECURE_HSTS_SECONDS=31536000
# LOG_LEVEL=INFO
# ensure_admin: ADMIN_USERNAME / ADMIN_PASSWORD (SSM /ecg/prod/)
