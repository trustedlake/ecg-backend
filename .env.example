# Copie para .env e preencha com seus valores reais.
# DATABASE_URL do Neon (ver leitor-ecg/.env.local para a connection string de dev):
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require
# opcional:
DJANGO_SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# AWS — se não setado aqui, boto3 usa a cadeia padrão; para dev use o perfil:
AWS_PROFILE=trustedlake
# AWS_REGION=sa-east-1
# AWS_IMAGES_BUCKET=ecg-lambdas-images-785236377332-sa-east-1
# AWS_RESULTS_BUCKET=ecg-lambdas-results-785236377332-sa-east-1
# AWS_LAMBDA_GRIDLINE_TRACE=ecg-lambdas-lambda-1-gridline-and-trace
# AWS_LAMBDA_SIGNAL_EXTRACTION=ecg-lambdas-lambda-2-signal-extraction
# AWS_LAMBDA_DIAGNOSIS=ecg-lambdas-lambda-3-diagnosis
# PRESIGN_URL_EXPIRES=3600
